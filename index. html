<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AR Dress Demo</title>

<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>

<style>
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f2f2f2;
  text-align:center;
}

h1{
  margin:20px 0;
}

model-viewer{
  width:100%;
  height:70vh;
  background:#ffffff;
}

#ar-button{
  background:#0d6efd;
  color:white;
  border:none;
  padding:15px 25px;
  border-radius:10px;
  font-size:18px;
  cursor:pointer;
}
</style>
</head>

<body>

<h1>👕 AR Dress Demo</h1>

<model-viewer
  src="https://res.cloudinary.com/yvxgirqh/image/upload/v1785947109/men_regular_apparel_fit_sporty_t-shirt_jmzvmh.glb"
  ar
  ar-modes="scene-viewer webxr quick-look"
  camera-controls
  auto-rotate>

  <button id="ar-button" slot="ar-button">
    👕 Open AR
  </button>

</model-viewer>

</body>
</html>
